{
  "tasks": [
    {
      "dependsOn": [
        "PlatformIO: Build",
        "Copy Hex on remote",
        "Flash local hex robot1"
      ],
      "dependsOrder": "sequence",
      "isBuildCommand": true,
      "label": "Compile and flash robot1",
      "problemMatcher": []
    },
    {
      "command": "ssh -tt dvb@${input:robot1Host} 'sudo teensy_loader_cli -w -s --mcu=teensy41 /tmp/firmware.hex'",
      "label": "Flash local hex robot1",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "uv run pio run -e teensy41",
      "label": "PlatformIO: Build",
      "problemMatcher": [],
      "type": "shell"
    },
    {
      "command": "scp .pio/build/teensy41/firmware.hex dvb@${input:robot1Host}:/tmp",
      "label": "Copy Hex on remote",
      "problemMatcher": [],
      "type": "shell"
    }
  ],
  "inputs": [
    {
      "id": "robot1Host",
      "type": "promptString",
      "description": "robot1 hostname or IP",
      "default": "rob.local"
    }
  ],
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0"
}
