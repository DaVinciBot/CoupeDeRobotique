# Global parameters
SHOW_ARENA=True
SHOW_CAMERA_FEED=True
CALIBRATE_MODE=False
DEBUG_MODE=False
USE_THREADED_CAMERA=True  # Utiliser un thread séparé pour la lecture caméra (améliore FPS)
USE_CSI_CAMERA=False  # Utiliser une caméra CSI (IMX219) avec GStreamer (True pour Jetson avec caméra CSI)

# Image capture parameters
IMAGE_DIR="captured_images"
IMAGE_EXT="jpg"
MAX_IMAGE=50

# Camera parameters
CAMERA_ID=0  # Pour CSI: 0=CAM0, 1=CAM1 sur Jetson
FPS=15  # FPS de la caméra (forcé à 15 fps pour CSI, configurable pour autres caméras)
CAMERA_BACKEND=V4L2  # V4L2 pour Linux/Jetson, DSHOW pour Windows (ignoré si USE_CSI_CAMERA=True)

# Note: Pour les caméras CSI (USE_CSI_CAMERA=True), la résolution est forcée à 1920x1080 @ 15fps
# Ces paramètres sont utilisés uniquement pour les caméras USB/V4L2
CAMERA_WIDTH=1920 # Only used if camera calibration data is not available
CAMERA_HEIGHT=1080 # Only used if camera calibration data is not available
ASSUMED_HFOV_DEG=90.0 # Only used if camera calibration data is not available
DIST_COEFFS="0.09917680765515181 -0.22904221842975478 -0.00305382112008446 0.0062126203515755745 0.13463424626732406"
CAMERA_MATRIX="1490.267816340181 0.0 959.5 0.0 1490.267816340181 539.5 0.0 0.0 1.0"

# Calibration parameters
CHESSBOARD_ROWS=9
CHESSBOARD_COLS=6
SQUARE_SIZE_CM=2.45
NUM_CALIB_IMAGES=50 # Should be in the range [50, 100]

# ArUco marker parameters - Only used for distance estimation
MARKER_SIZE_CM=2.1
MARKER_SIZE_REF_CM=12.0
MARKER_SIZE_CRATE_CM=5.0