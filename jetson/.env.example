# ===== MODES D'UTILISATION =====
CALIBRATE_MODE=False  # True = calibration, False = détection
DEBUG_MODE=False      # Affiche les statistiques de performance

# ===== AFFICHAGE =====
SHOW_ARENA=True         # Afficher la vue de l'arène 2D
SHOW_CAMERA_FEED=True   # Afficher le flux caméra avec annotations

# ===== CAMÉRA CSI (IMX219) =====
# La caméra est toujours en 1920x1080 @ 15fps (forcé dans le code)
CAMERA_ID=0  # 0=CAM0, 1=CAM1 sur Jetson Nano

# ===== CALIBRATION (résultats à copier ici après calibration) =====
CAMERA_MATRIX="1490.267816340181 0.0 959.5 0.0 1490.267816340181 539.5 0.0 0.0 1.0"
DIST_COEFFS="0.09917680765515181 -0.22904221842975478 -0.00305382112008446 0.0062126203515755745 0.13463424626732406"
ASSUMED_HFOV_DEG=90.0  # Utilisé uniquement si CAMERA_MATRIX n'est pas disponible

# ===== PARAMÈTRES DE CALIBRATION =====
CHESSBOARD_COLS=9      # Nombre de coins intérieurs (largeur)
CHESSBOARD_ROWS=6      # Nombre de coins intérieurs (hauteur)
SQUARE_SIZE_CM=2.45    # Taille d'un carré en cm
NUM_CALIB_IMAGES=50    # Nombre d'images à capturer (50-100 recommandé)

# ===== MODES DUMMY (test sans matériel) =====
DUMMY_LORA=False         # True = désactive complètement le LoRa
DUMMY_DETECTION=False    # True = désactive caméra/détection, génère des données fictives
