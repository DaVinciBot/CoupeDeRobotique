# Arena vision (C++) configuration. Export these before running, e.g.:
#   set -a; source .env; set +a; ./arena_vision

# --- Camera / capture ---
CAMERA_ID=0
SENSOR_WIDTH=3280        # IMX219 full-FOV mode (max). No 4K mode exists on this sensor.
SENSOR_HEIGHT=2464
SENSOR_FPS=21            # 3280x2464 is capped at 21 fps; 1080p is the only 30 fps mode
DETECT_DOWNSCALE=1.0     # >1.0 downscales (GPU) before detection; tune only if needed

# --- Detection ---
NUM_THREADS=6            # Orin Nano core count; drives OpenCV parallel_for_ (ArUco)
DETECT_PARALLEL=off      # off | tile (2x2 parallel tiles) | frame (N round-robin threads)

# --- Marker IDs ---
ROBOT_MARKER_ID=6        # ally robot
ENEMY_MARKER_ID=1
BLUE_CRATE_MARKER_ID=36
YELLOW_CRATE_MARKER_ID=47
EMPTY_CRATE_MARKER_ID=41

# --- Zones ---
ZONE_TOLERANCE_CM=5.0

# --- LoRa (UART) ---
LORA_PORT=/dev/ttyTHS1
LORA_BAUD=115200

# --- Optional camera calibration (OpenCV FileStorage .yml with camera_matrix, dist_coeffs) ---
# CALIBRATION_FILE=calibration.yml

# --- Modes / debugging ---
DUMMY_LORA=false         # log packets instead of writing to UART
DUMMY_DETECTION=false    # synthetic world (no camera) to test FSM + protocol
# INPUT_FILE=arena.png   # use an image/video instead of the CSI camera
DEBUG_MODE=false         # per-frame JSON + FPS to stdout
ENABLE_KEYBOARD=false
