{
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "editor.codeActionsOnSave": {
    "source.convertImportFormat": "explicit",
    "source.organizeImports": "explicit",
    "source.sort.json": "explicit",
    "source.unusedImports": "explicit"
  },
  "errorLens.enabledDiagnosticLevels": ["error", "warning", "info", "hint"],
  "files.associations": {
    "__availability": "cpp",
    "__config": "cpp",
    "*.rs": "rust",
    "algorithm": "cpp",
    "atomic": "cpp",
    "chrono": "cpp",
    "compare": "cpp",
    "complex": "cpp",
    "cstddef": "cpp",
    "exception": "cpp",
    "filesystem": "cpp",
    "format": "cpp",
    "fstream": "cpp",
    "initializer_list": "cpp",
    "list": "cpp",
    "new": "cpp",
    "random": "cpp",
    "sstream": "cpp",
    "streambuf": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "vector": "cpp",
    "xhash": "cpp",
    "xstring": "cpp",
    "xutility": "cpp"
  },
  "python.analysis.autoFormatStrings": true,
  "python.analysis.diagnosticMode": "workspace",
  "todo-tree.general.tagGroups": {
    "FIXME": ["FIXME", "FIXIT", "FIX"],
    "HACK": ["HACK", "ENHANCE"]
  },
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "ENHANCE",
    "FIXME",
    "FIXIT",
    "FIX",
    "TODO",
    "TOTEST",
    "QUESTION",
    "[ ]",
    "[x]"
  ],
  "todo-tree.highlights.customHighlight": {
    "BUG": {
      "background": "white",
      "foreground": "red",
      "textDecoration": "underline"
    },
    "FIXME": {
      "foreground": "orange",
      "iconColour": "yellow"
    },
    "QUESTION": {
      "foreground": "purple",
      "icon": "question",
      "iconColour": "purple"
    },
    "TODO": {
      "foreground": "cyan"
    },
    "TOTEST": {
      "foreground": "lime",
      "icon": "codescan-checkmark"
    }
  },
  "todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true,
    "type": "text-and-comment"
  }
}
