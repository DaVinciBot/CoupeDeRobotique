{
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.formatting.provider": "black",
    "python.analysis.extraPaths": [
        "./common"
    ],
    "cmake.configureOnOpen": false,
    "files.associations": {
        "*.rs": "rust",
        "__availability": "cpp",
        "__config": "cpp",
        "atomic": "cpp",
        "chrono": "cpp",
        "compare": "cpp",
        "exception": "cpp",
        "filesystem": "cpp",
        "fstream": "cpp",
        "new": "cpp",
        "random": "cpp",
        "sstream": "cpp",
        "streambuf": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "vector": "cpp",
        "algorithm": "cpp",
        "complex": "cpp",
        "cstddef": "cpp",
        "format": "cpp",
        "initializer_list": "cpp",
        "list": "cpp",
        "utility": "cpp",
        "xhash": "cpp",
        "xstring": "cpp",
        "xutility": "cpp",
        "type_traits": "cpp"
    },
    "todo-tree.highlights.defaultHighlight": {
        "gutterIcon": true,
        "type": "text-and-comment"
    },
    "todo-tree.highlights.customHighlight": {
        "TODO": {
            "foreground": "cyan"
        },
        "FIXME": {
            "iconColour": "yellow",
            "foreground": "orange"
        },
        "BUG": {
            "foreground": "red",
            "background": "white",
            "textDecoration": "underline"
        },
        "QUESTION": {
            "icon": "question",
            "iconColour": "purple",
            "foreground": "purple"
        },
    },
    "todo-tree.highlights.backgroundColourScheme": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "indigo",
        "violet",
        "cyan"
    ],
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "FIXIT",
        "FIX",
        "TODO",
        "QUESTION",
        "[ ]",
        "[x]"
    ],
    "todo-tree.general.tagGroups": {
        "FIXME": [
            "FIXME",
            "FIXIT",
            "FIX",
        ]
    }
}
