{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "cmake.configureOnOpen": false,
    "editor.codeActionsOnSave": {
        "source.convertImportFormat": "explicit",
        "source.organizeImports": "explicit",
        "source.sort.json": "explicit",
        "source.unusedImports": "explicit"
    },
    "errorLens.enabledDiagnosticLevels": [
        "error",
        "warning",
        "info",
        "hint"
    ],
    "files.associations": {
        "__availability": "cpp",
        "__config": "cpp",
        "*.rs": "rust",
        "algorithm": "cpp",
        "atomic": "cpp",
        "chrono": "cpp",
        "compare": "cpp",
        "complex": "cpp",
        "cstddef": "cpp",
        "exception": "cpp",
        "filesystem": "cpp",
        "format": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "list": "cpp",
        "new": "cpp",
        "random": "cpp",
        "sstream": "cpp",
        "streambuf": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "vector": "cpp",
        "xhash": "cpp",
        "xstring": "cpp",
        "xutility": "cpp"
    },
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticMode": "workspace",
    "python.analysis.diagnosticSeverityOverrides": {
        "reportCallInDefaultInitializer": "error",
        "reportConstantRedefinition": "warning",
        "reportDeprecated": "warning",
        "reportImplicitOverride": "information",
        "reportImportCycles": "error",
        "reportInconsistentConstructor": "information",
        "reportMatchNotExhaustive": "warning",
        "reportMissingImports": "warning",
        "reportMissingModuleSource": "information",
        "reportMissingParameterType": "information",
        "reportMissingTypeArgument": "information",
        "reportPossiblyUnboundVariable": "none",
        "reportPrivateImportUsage": "none",
        "reportPrivateUsage": "information",
        "reportPropertyTypeMismatch": "warning",
        "reportShadowedImports": "warning",
        "reportUninitializedInstanceVariable": "information",
        "reportUnknownLambdaType": "warning",
        "reportUnknownVariableType": "information",
        "reportUnnecessaryCast": "information",
        "reportUnnecessaryComparison": "information",
        "reportUnnecessaryContains": "information",
        "reportUnnecessaryIsInstance": "information",
        "reportUnnecessaryTypeIgnoreComment": "information",
        "reportUnreachable": "warning",
        "reportUntypedBaseClass": "error",
        "reportUntypedClassDecorator": "error",
        "reportUntypedFunctionDecorator": "error",
        "reportUntypedNamedTuple": "error",
        "reportUnusedClass": "information",
        "reportUnusedExpression": "information",
        "reportUnusedFunction": "information",
        "reportUnusedImport": "information"
    },
    "python.analysis.extraPaths": [
        "./common"
    ],
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.useLibraryCodeForTypes": true,
    "todo-tree.general.tagGroups": {
        "FIXME": [
            "FIXME",
            "FIXIT",
            "FIX"
        ]
    },
    "todo-tree.general.tags": [
        "BUG",
        "FIX",
        "FIXIT",
        "FIXME",
        "HACK",
        "QUESTION",
        "TODO",
        "UNUSED",
        "[ ]",
        "[x]"
    ],
    "todo-tree.highlights.backgroundColourScheme": [
        "red",
        "orange",
        "yellow",
        "green",
        "blue",
        "indigo",
        "violet",
        "cyan"
    ],
    "todo-tree.highlights.customHighlight": {
        "BUG": {
            "background": "white",
            "foreground": "red",
            "textDecoration": "underline"
        },
        "FIXME": {
            "foreground": "orange",
            "iconColour": "yellow"
        },
        "QUESTION": {
            "foreground": "purple",
            "icon": "question",
            "iconColour": "purple"
        },
        "TODO": {
            "foreground": "cyan"
        },
        "UNUSED": {
            "foreground": "grey",
            "icon": "eye-closed",
            "iconColour": "grey"
        },
    },
    "todo-tree.highlights.defaultHighlight": {
        "gutterIcon": true,
        "type": "text-and-comment"
    }
}
